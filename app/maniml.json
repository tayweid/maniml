{
  "name": "ManimLive",
  "id": "io.tayweid.manimlive",
  "envPrefix": "MANIML",
  "package": "maniml",
  "devPython": "..",
  "site": "https://maniml.tayweid.io",
  "elsewhere": "Elsewhere, see https://github.com/tayweid/maniml#readme.",
  "port": 8690,
  "pythons": [
    "uv"
  ],
  "scheme": "manimlive",
  "setupPage": "static/setup.html",
  "defaultDocument": "scene.py",
  "engine": {
    "args": [
      "-m",
      "maniml",
      "app",
      "--allow-outside-root"
    ],
    "marker": "web/app.py",
    "probe": "manimlive",
    "python": "3.13",
    "requirements": [
      "audioop-lts>=0.2.1; python_version >= '3.13'",
      "numpy>=1.19.0",
      "pillow>=8.0.0",
      "pydub>=0.25.1",
      "colour>=0.1.5",
      "pygments>=2.6.0",
      "PyYAML>=5.3.0",
      "addict>=2.4.0",
      "validators>=0.18.0",
      "appdirs>=1.4.0",
      "mapbox-earcut>=1.0.0",
      "svgelements>=1.0.0",
      "isosurfaces>=0.1.0",
      "manimpango>=0.4.0",
      "websockets>=13.0",
      "fonttools>=4.0.0",
      "wgpu>=0.32"
    ],
    "startTimeout": 60000
  },
  "window": {
    "width": 1280,
    "height": 820,
    "minWidth": 640,
    "minHeight": 400
  },
  "icon": "../maniml/web/static/icons/maniml-512.png",
  "copyright": "© 2026 Taylor J Weidman. MIT License.",
  "smoke": {
    "document": "smoke.py",
    "text": "from manim import *\n\nclass Smoke(Scene):\n    def construct(self):\n        self.add(Square())\n",
    "ready": "#file-name",
    "readyText": "smoke.py"
  },
  "documentTypes": [
    {
      "name": "Manim scene",
      "role": "Viewer",
      "rank": "Alternate",
      "contentTypes": [
        "public.python-script"
      ],
      "extensions": [
        "py"
      ]
    }
  ]
}
